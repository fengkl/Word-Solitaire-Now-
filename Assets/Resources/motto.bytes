    "06-01": {
      "en": [
        "Peace begins with a smile.",
        "MOTHER TERESA"
      ],
      "zh-hant": [
        "少年心，最珍貴。從某種意義上說，這世界上其實沒有大人，只有長皺了的小孩。",
        "嚴明"
      ],
      "ja": [
        "悲しみは雷雲に似ている。遠方から見 ればそれは真黒であり、頭上にくればほとんど灰色である。",
        "ジャン・ポール・リヒター"
      ],
      "es": [
